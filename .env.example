# LLM provider configuration
# Keep real keys only in .env or an enterprise secret manager. Never commit them.
# When no *_MODEL_CHAIN is configured, all four roles use this provider together
# with the legacy *_MODEL values below. If this is not qwen, replace all four
# qwen-plus defaults with model IDs supported by the selected provider.
LLM_PROVIDER=qwen

# Alibaba Cloud Model Studio / Qwen
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# China (Beijing) OpenAI-compatible endpoint.
# For another region or a workspace-specific domain, replace this value.
# Remote provider endpoints must use HTTPS (HTTP is accepted only on loopback).
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini. GEMINI_API_KEY is also accepted as an alias.
GOOGLE_API_KEY=

# Anthropic Claude. Leave the base URL empty for the official endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Backward-compatible single-provider model configuration
ROUTER_MODEL=qwen-plus
SQL_GENERATOR_MODEL=qwen-plus
REFLECTOR_MODEL=qwen-plus
VISUALIZER_MODEL=qwen-plus

# Optional ordered failover chains. Providers referenced by an active chain need
# keys; roles with an empty chain use LLM_PROVIDER and the legacy model value.
# Syntax: provider:model,provider:model
# Supported providers: qwen, deepseek, openai, gemini, anthropic (or claude).
# Example:
# ROUTER_MODEL_CHAIN=qwen:qwen-plus,deepseek:deepseek-chat
# SQL_GENERATOR_MODEL_CHAIN=qwen:qwen-plus,deepseek:deepseek-chat,openai:<model-id>
# REFLECTOR_MODEL_CHAIN=qwen:qwen-plus,claude:<model-id>
# VISUALIZER_MODEL_CHAIN=qwen:qwen-plus,gemini:<model-id>
ROUTER_MODEL_CHAIN=
SQL_GENERATOR_MODEL_CHAIN=
REFLECTOR_MODEL_CHAIN=
VISUALIZER_MODEL_CHAIN=

LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Optional LangSmith tracing
LANGSMITH_API_KEY=

# Application Settings
MAX_RETRY_COUNT=3
MAX_RESULT_ROWS=50
MAX_RESULT_BYTES=5242880
SQL_QUERY_TIMEOUT_SECONDS=15
MAX_SQL_QUERY_BYTES=100000
MAX_RESULT_COLUMNS=200

# Dashboard query refresh and remote snapshot synchronization interval.
# The application clamps this value to 30-3600 seconds.
DASHBOARD_REFRESH_SECONDS=300

# Comma-separated host:port endpoints that data managers may connect to.
# Exact endpoints and patterns such as *.example.internal:3306 are supported.
# Use * only in a fully trusted demo network.
DATASOURCE_ALLOWED_HOSTS=localhost:3306,localhost:5432,127.0.0.1:3306,127.0.0.1:5432,[::1]:3306,[::1]:5432

# Local authentication and authorization
# The password database is separate from business-data snapshots.
CHATBI_META_DB_PATH=data/system/chatbi_meta.db
AUTH_SESSION_TIMEOUT_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_CONCURRENT_PASSWORD_CHECKS=2
AUTH_AUDIT_MAX_ROWS=50000
AUTH_AUDIT_RETENTION_DAYS=180
